# Connects the /dashboard and /scanner pages to a running trading bot.
#
# Leave these unset and the pages fall back to their built-in simulation,
# clearly badged "SIMULATED" so fake numbers are never mistaken for real
# positions. Set both to go live.
#
# These are read only on the server, inside pages/api/bot/* — they are never
# bundled into the browser. Do not prefix them with NEXT_PUBLIC_.

# Base URL of the bot's dashboard API (the Express app in the bot repo).
BOT_API_URL=http://localhost:4000

# The dashboard password whose hash you put in the bot's DASHBOARD_PASSWORD_HASH
# (generate the hash there with `npm run hash-password -- "<password>"`).
BOT_DASHBOARD_PASSWORD=your-dashboard-password
